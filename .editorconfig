root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Raw inputs are kept byte for byte (see data-raw/MD5SUMS).
[data-raw/{original,shapefile}/**]
trim_trailing_whitespace = false
insert_final_newline = false
